{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odd_world_model.assurance_record.schema.json",
  "title": "AssuranceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_kind",
    "schema_version",
    "assurance_id",
    "object_ref",
    "claim_key",
    "claim_kind",
    "accepted_value",
    "trace_record_refs",
    "authority_basis",
    "accepted_at"
  ],
  "properties": {
    "schema_kind": {
      "const": "odd_world_model.assurance_record"
    },
    "schema_version": {
      "const": "v1"
    },
    "assurance_id": {
      "type": "string",
      "minLength": 1
    },
    "object_ref": {
      "type": "string",
      "minLength": 1
    },
    "claim_key": {
      "type": "string",
      "minLength": 1
    },
    "claim_kind": {
      "type": "string",
      "minLength": 1
    },
    "accepted_value": {},
    "trace_record_refs": {
      "$ref": "world_model_object.schema.json#/$defs/string_array"
    },
    "authority_basis": {
      "$ref": "world_model_object.schema.json#/$defs/string_array"
    },
    "ambiguity_notes": {
      "$ref": "world_model_object.schema.json#/$defs/string_array"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string"
    }
  }
}
