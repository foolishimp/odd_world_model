{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odd_world_model.fragment.schema.json",
  "title": "WorldFragment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_kind",
    "schema_version",
    "fragment_id",
    "bounded_context",
    "published_at",
    "objects",
    "treatments",
    "edges",
    "projections",
    "evidence_manifests"
  ],
  "properties": {
    "schema_kind": {
      "const": "odd_world_model.world_fragment"
    },
    "schema_version": {
      "const": "v1"
    },
    "fragment_id": {
      "type": "string",
      "minLength": 1
    },
    "bounded_context": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_by": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "attribute_ledger_entries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reference_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "treatments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_manifests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
