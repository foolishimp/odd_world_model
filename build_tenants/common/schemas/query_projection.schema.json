{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odd_world_model.query_projection.schema.json",
  "title": "World Model Query Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_kind",
    "schema_version",
    "query_ref",
    "query_contract_ref",
    "query_contract_version",
    "semantic_cut",
    "physical_admission_witness",
    "context_basis",
    "context_projection",
    "exact_snapshots",
    "result",
    "projected_at",
    "query_digest"
  ],
  "properties": {
    "schema_kind": { "const": "odd_world_model.query_projection" },
    "schema_version": { "const": "v1" },
    "query_ref": { "type": "string", "minLength": 1 },
    "query_contract_ref": { "type": "string", "minLength": 1 },
    "query_contract_version": { "type": "string", "minLength": 1 },
    "semantic_cut": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "physical_admission_witness": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "context_basis": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "context_projection": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "exact_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "table_identifier",
          "snapshot_id",
          "metadata_location",
          "schema_fingerprint",
          "payload_digest",
          "record_count"
        ],
        "properties": {
          "table_identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
          "snapshot_id": { "type": "string", "pattern": "^[0-9]+$" },
          "metadata_location": { "type": "string", "minLength": 1 },
          "schema_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "payload_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "record_count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interaction_goal",
        "root_refs",
        "traversed_semantic_cut_refs",
        "traversed_semantic_link_refs",
        "semantic_cut_count",
        "semantic_link_count",
        "included_ref_count",
        "omitted_ref_count",
        "fidelity",
        "declared_losses"
      ],
      "properties": {
        "interaction_goal": { "type": "string", "minLength": 1 },
        "root_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "odd_world_model.exact_ref.schema.json" } },
        "traversed_semantic_cut_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "odd_world_model.exact_ref.schema.json" } },
        "traversed_semantic_link_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "odd_world_model.exact_ref.schema.json" } },
        "semantic_cut_count": { "type": "integer", "minimum": 0 },
        "semantic_link_count": { "type": "integer", "minimum": 0 },
        "included_ref_count": { "type": "integer", "minimum": 0 },
        "omitted_ref_count": { "type": "integer", "minimum": 0 },
        "fidelity": { "enum": ["exact_payload", "lossless_projection", "lossy_projection"] },
        "declared_losses": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "projected_at": { "type": "string", "minLength": 1 },
    "query_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
