    },
    "schema_version": {
      "const": "v1"
    },
    "edge_id": {
      "type": "string",
      "minLength": 1
    },
    "source_object_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_object_ref": {
      "type": "string",
      "minLength": 1
    },
    "relationship_kind": {
      "type": "string",
      "enum": [
        "equivalent",
        "corresponding",
        "partial_correspondence",
        "treatment_effect",
        "aggregation",
        "decomposition"
      ]
    },
    "ambiguity_notes": {
      "$ref": "odd_world_model.world_model_object.schema.json#/$defs/string_array"
