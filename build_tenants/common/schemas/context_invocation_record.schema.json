{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odd_world_model.context_invocation_record.schema.json",
  "title": "ContextInvocationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_kind", "schema_version", "invocation_ref", "context_basis", "context_projection", "model_identity", "model_role", "invoked_at", "completed_at", "output_digest", "output_proposal_ref", "abg_event_refs", "admission", "freshness_catalog", "admission_status", "freshness_status", "invocation_digest"],
  "properties": {
    "schema_kind": { "const": "odd_world_model.context_invocation_record" },
    "schema_version": { "const": "v1" },
    "invocation_ref": { "type": "string", "minLength": 1 },
    "context_basis": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "context_projection": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "model_identity": { "type": "string", "minLength": 1 },
    "model_role": { "const": "F_P" },
    "invoked_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "output_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "output_proposal_ref": { "type": "string", "minLength": 1 },
    "abg_event_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "admission": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "freshness_catalog": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "admission_status": { "const": "admitted" },
    "freshness_status": { "const": "fresh" },
    "invocation_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
