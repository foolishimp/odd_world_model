{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odd_world_model.semantic_cut_attestation.schema.json",
  "title": "SemanticCutAttestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_kind",
    "schema_version",
    "attestation_id",
    "write_request_id",
    "request_digest",
    "semantic_cut_ref",
    "semantic_cut_digest",
    "cut_role",
    "cut_version",
    "snapshots",
    "governing_refs",
    "source_refs",
    "authority_refs",
    "abg_event_refs",
    "dependency_identities",
    "fidelity",
    "losses",
    "exclusions",
    "gap_refs",
    "created_at",
    "attestation_digest"
  ],
  "properties": {
    "schema_kind": {
      "const": "odd_world_model.semantic_cut_attestation"
    },
    "schema_version": {
      "const": "v1"
    },
    "attestation_id": {
      "type": "string",
      "minLength": 1
    },
    "write_request_id": {
      "type": "string",
      "minLength": 1
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "semantic_cut_ref": {
      "type": "string",
      "minLength": 1
    },
    "semantic_cut_digest": {
      "$ref": "#/$defs/digest"
    },
    "cut_role": {
      "type": "string",
      "minLength": 1
    },
    "cut_version": {
      "type": "string",
      "minLength": 1
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "governing_refs": {
      "$ref": "odd_world_model.world_model_object.schema.json#/$defs/string_array"
    },
    "source_refs": {
      "$ref": "odd_world_model.world_model_object.schema.json#/$defs/string_array"
    },
    "authority_refs": {
      "$ref": "odd_world_model.world_model_object.schema.json#/$defs/string_array"
    },
    "graph_invocation_ref": {
      "type": "string",
      "minLength": 1
    },
    "abg_event_refs": {
      "$ref": "odd_world_model.world_model_object.schema.json#/$defs/string_array"
    },
    "dependency_identities": {
      "$ref": "odd_world_model.world_model_object.schema.json#/$defs/string_array"
    },
    "temporal_coordinates": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "fidelity": {
      "type": "string",
      "enum": [
        "exact_payload",
        "lossless_projection",
        "lossy_projection"
      ]
    },
    "losses": {
      "$ref": "odd_world_model.world_model_object.schema.json#/$defs/string_array"
    },
    "exclusions": {
      "$ref": "odd_world_model.world_model_object.schema.json#/$defs/string_array"
    },
    "gap_refs": {
      "$ref": "odd_world_model.world_model_object.schema.json#/$defs/string_array"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "attestation_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_identifier",
        "snapshot_id",
        "metadata_location",
        "schema_fingerprint",
        "payload_digest",
        "record_count"
      ],
      "properties": {
        "table_identifier": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "metadata_location": {
          "type": "string",
          "minLength": 1
        },
        "schema_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
