{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odd_world_model.accepted_semantic_cut.schema.json",
  "title": "AcceptedSemanticCut",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_kind", "schema_version", "semantic_cut_ref", "cut_role", "cut_version", "epistemic_status", "proposal", "source_observation", "deterministic_check", "proposal_admission", "acceptance_decision", "acceptance_admission", "semantic_payload_digest", "governing_refs", "source_refs", "authority_refs", "dependency_identities", "temporal_coordinates", "fidelity", "losses", "exclusions", "gaps", "accepted_at", "accepted_cut_digest"],
  "properties": {
    "schema_kind": { "const": "odd_world_model.accepted_semantic_cut" },
    "schema_version": { "const": "v1" },
    "semantic_cut_ref": { "type": "string", "minLength": 1 },
    "cut_role": { "enum": ["source_domain", "domain_artifact", "common_model", "composed_world_model"] },
    "cut_version": { "type": "string", "minLength": 1 },
    "epistemic_status": { "const": "candidate" },
    "proposal": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "source_observation": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "deterministic_check": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "proposal_admission": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "acceptance_decision": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "acceptance_admission": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "semantic_payload_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "governing_refs": { "$ref": "#/$defs/string_array" },
    "source_refs": { "$ref": "#/$defs/string_array" },
    "authority_refs": { "$ref": "#/$defs/string_array_nonempty" },
    "dependency_identities": { "$ref": "#/$defs/string_array_nonempty" },
    "temporal_coordinates": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
    "fidelity": { "enum": ["exact_payload", "lossless_projection", "lossy_projection"] },
    "losses": { "$ref": "#/$defs/string_array" },
    "exclusions": { "$ref": "#/$defs/string_array" },
    "gaps": { "type": "array", "items": { "$ref": "odd_world_model.typed_gap.schema.json" } },
    "accepted_at": { "type": "string", "format": "date-time" },
    "accepted_cut_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "string_array": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "string_array_nonempty": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
