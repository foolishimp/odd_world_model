{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odd_world_model.candidate_markov_object_cut.schema.json",
  "title": "CandidateMarkovObjectCut",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_kind", "schema_version", "object_ref", "object_identity", "identity_direction", "projection_support_refs", "distributed_ledger_evidence_refs", "candidate_basis", "null_peer_basis", "held_out_treatment_verification", "boundary", "publication_classification", "source_observation", "authority_ref", "created_at", "cut_digest"],
  "properties": {
    "schema_kind": { "const": "odd_world_model.candidate_markov_object_cut" },
    "schema_version": { "const": "v1" },
    "object_ref": { "type": "string", "minLength": 1 },
    "object_identity": { "type": "string", "minLength": 1 },
    "identity_direction": {
      "type": "object", "additionalProperties": false,
      "required": ["source_state_refs", "target_state_refs", "projection_ref"],
      "properties": {
        "source_state_refs": { "$ref": "#/$defs/nonempty_refs" },
        "target_state_refs": { "$ref": "#/$defs/nonempty_refs" },
        "projection_ref": { "type": "string", "minLength": 1 }
      }
    },
    "projection_support_refs": { "$ref": "#/$defs/nonempty_refs" },
    "distributed_ledger_evidence_refs": { "$ref": "#/$defs/nonempty_refs" },
    "candidate_basis": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "null_peer_basis": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "held_out_treatment_verification": {
      "type": "object", "additionalProperties": false,
      "required": ["treatment_ref", "corpus_ref", "result", "evidence_refs"],
      "properties": {
        "treatment_ref": { "type": "string", "minLength": 1 },
        "corpus_ref": { "type": "string", "minLength": 1 },
        "result": { "const": "inconclusive" },
        "evidence_refs": { "$ref": "#/$defs/nonempty_refs" }
      }
    },
    "boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["included_refs", "excluded_refs", "rationale"],
      "properties": {
        "included_refs": { "$ref": "#/$defs/nonempty_refs" },
        "excluded_refs": { "$ref": "#/$defs/refs" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "publication_classification": { "const": "candidate" },
    "source_observation": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "authority_ref": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "cut_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonempty_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
