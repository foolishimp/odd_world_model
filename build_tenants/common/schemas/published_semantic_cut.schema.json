{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odd_world_model.published_semantic_cut.schema.json",
  "title": "PublishedSemanticCut",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_kind", "schema_version", "semantic_cut_ref", "cut_role", "cut_version", "publication_status", "epistemic_status", "source_observation", "publication_candidate", "publication_admission_witness", "accepted_semantic_cut", "semantic_cut_attestation", "physical_effect_observation", "physical_admission_witness", "snapshot_refs", "semantic_payload_digest", "governing_refs", "source_refs", "authority_refs", "dependency_identities", "temporal_coordinates", "fidelity", "losses", "exclusions", "gaps", "published_at", "publication_digest"],
  "properties": {
    "schema_kind": { "const": "odd_world_model.published_semantic_cut" },
    "schema_version": { "const": "v1" },
    "semantic_cut_ref": { "type": "string", "minLength": 1 },
    "cut_role": { "enum": ["source_domain", "domain_artifact", "common_model", "composed_world_model"] },
    "cut_version": { "type": "string", "minLength": 1 },
    "publication_status": { "const": "published" },
    "epistemic_status": { "const": "candidate" },
    "source_observation": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "publication_candidate": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "publication_admission_witness": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "accepted_semantic_cut": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "semantic_cut_attestation": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "physical_effect_observation": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "physical_admission_witness": { "$ref": "odd_world_model.exact_ref.schema.json" },
    "snapshot_refs": { "type": "array", "minItems": 1, "items": { "$ref": "odd_world_model.exact_ref.schema.json" } },
    "semantic_payload_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "governing_refs": { "$ref": "#/$defs/string_array" },
    "source_refs": { "$ref": "#/$defs/string_array" },
    "authority_refs": { "$ref": "#/$defs/string_array_nonempty" },
    "dependency_identities": { "$ref": "#/$defs/string_array_nonempty" },
    "temporal_coordinates": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
    "fidelity": { "enum": ["exact_payload", "lossless_projection", "lossy_projection"] },
    "losses": { "$ref": "#/$defs/string_array" },
    "exclusions": { "$ref": "#/$defs/string_array" },
    "gaps": { "type": "array", "items": { "$ref": "odd_world_model.typed_gap.schema.json" } },
    "published_at": { "type": "string", "format": "date-time" },
    "publication_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "string_array": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "string_array_nonempty": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
